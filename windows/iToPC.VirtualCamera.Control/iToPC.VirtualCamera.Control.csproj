<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <AssemblyName>iToPC.VirtualCamera.Control</AssemblyName>
    <RootNamespace>iToPC.VirtualCamera.Control</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="DirectN">
      <HintPath>..\iToPC.VirtualCamera.Source\External\DirectN.dll</HintPath>
    </Reference>
    <Reference Include="DirectN.Extensions">
      <HintPath>..\iToPC.VirtualCamera.Source\External\DirectN.Extensions.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
