<Window x:Class="iToPC.Receiver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iToPC Receiver" Height="700" Width="800"
        MinHeight="660" MinWidth="740" WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource AccentBrush}" CornerRadius="3"/>
            <StackPanel Grid.Column="2">
                <TextBlock Text="iToPC Receiver" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Text="iPhoneカメラをUSB優先・最小バッファで表示"
                           FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="接続方法" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                    <RadioButton x:Name="UsbModeButton" Content="USB（推奨）" IsChecked="True" Margin="0,0,0,8" Checked="ConnectionModeChanged"/>
                    <RadioButton x:Name="WifiModeButton" Content="Wi-Fi" Checked="ConnectionModeChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="iPhoneのIPアドレス（Wi-Fi時のみ）" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBox x:Name="PhoneAddressBox" Text="192.168.1.2" Margin="0,7,0,0" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="映像設定" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                    <CheckBox x:Name="HardwareDecodeCheck" Content="D3D11VA ハードウェアデコード" IsChecked="True" Margin="0,0,0,9"/>
                    <CheckBox x:Name="VirtualCameraCheck" Content="iToPC Cameraへ出力（1080p / 60fps）" IsChecked="True"/>
                    <Button x:Name="VirtualCameraInstallButton" Content="仮想カメラをインストール"
                            HorizontalAlignment="Left" Margin="0,14,0,0" Padding="12,6"
                            Click="VirtualCameraInstallClicked"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="入力FPS" Style="{StaticResource SectionTitleStyle}"/>
                    <ComboBox x:Name="FpsBox" SelectedIndex="0" Margin="0,7,0,0">
                        <ComboBoxItem Content="120"/>
                        <ComboBoxItem Content="60"/>
                        <ComboBoxItem Content="30"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="ポート" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBox x:Name="PortBox" Text="5000" Margin="0,7,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="FFmpegツール（ffplay.exeを指定）" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBox x:Name="FfplayPathBox" Margin="0,8,10,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="参照…" MinWidth="82" VerticalAlignment="Bottom" Click="BrowseFfplayClicked"/>
            </Grid>
        </Border>

        <TextBox Grid.Row="4" x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas"
                 FontSize="12.5" Background="#070A10" BorderBrush="#2D6ECF"
                 BorderThickness="1" Padding="12"/>

        <Grid Grid.Row="5" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Fill="#64748B" Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusText" Text="停止中" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="StartStopButton" Content="受信開始" MinWidth="132"
                    Background="{StaticResource AccentBrush}" Foreground="White"
                    BorderBrush="#69A1FF" Click="StartStopClicked"/>
        </Grid>
    </Grid>
</Window>
